# Narrow active-seat access for the experimental Bluetooth audio bridge.
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="0005:054C:0CE6.*", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/bustype}=="0005", ATTRS{id/vendor}=="054c", ATTRS{id/product}=="0ce6", TAG+="uaccess"

# DualSense and DualSense Edge over USB and Bluetooth.
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="000[35]:054C:0DF2.*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="0003:054C:0CE6.*", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="054c", ATTRS{id/product}=="0df2", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/bustype}=="0003", ATTRS{id/vendor}=="054c", ATTRS{id/product}=="0ce6", TAG+="uaccess"
# Mapping injection is limited to the explicitly configured DualWave group.
SUBSYSTEM=="misc", KERNEL=="uinput", GROUP="dualwave", MODE="0660", OPTIONS+="static_node=uinput"
